# ElevenLabs: credencial de backend e ID del agente existente.
# Copiar a .env (ignorado por Git) y completar solo en la computadora local.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LiveKit: solo backend, nunca usar prefijo VITE_ para claves o códigos.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generar un código propio de al menos 16 caracteres para el equipo.
LIVEKIT_JOIN_CODE=
# Demo local: iniciar el agente sin código de equipo. Solo con el backend en 127.0.0.1; quitar al publicar.
AGENT_OPEN_ACCESS=false
LIVEKIT_ROOM=userhelper-team
APP_ORIGIN=http://127.0.0.1:5173
LIVEKIT_TOKEN_PORT=3001
# Mantener en loopback; usar proxy HTTPS al desplegar.
LIVEKIT_TOKEN_HOST=127.0.0.1

# Bóveda Obsidian privada (opcional). Ruta ABSOLUTA a la carpeta de la bóveda, fuera de este repo.
# Ej.: /Users/<tu-usuario>/Documents/UserHelper-Vault  — clonar de github.com/soyabrahamarriaga-lang/userhelper-vault
VAULT_PATH=
# Cada cuántos minutos el backend copia a la bóveda las conversaciones terminadas del agente (0 = apagado).
VAULT_SYNC_MINUTES=2
# Webhook post-llamada de ElevenLabs (opcional; requiere URL pública HTTPS). Secreto que muestra ElevenLabs al crear el webhook.
ELEVENLABS_WEBHOOK_SECRET=
