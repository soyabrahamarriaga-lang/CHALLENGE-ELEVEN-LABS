# Alternativa API opcional. El MCP remoto usa OAuth y no necesita esta clave.
# Copiar a .env (ignorado por Git) y completar solo en la computadora local.
ELEVENLABS_API_KEY=

# LiveKit: solo backend, nunca usar prefijo VITE_ para claves o códigos.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generar un código propio de al menos 16 caracteres para el equipo.
LIVEKIT_JOIN_CODE=
LIVEKIT_ROOM=userhelper-team
APP_ORIGIN=http://127.0.0.1:5173
LIVEKIT_TOKEN_PORT=3001
# Mantener en loopback; usar proxy HTTPS al desplegar.
LIVEKIT_TOKEN_HOST=127.0.0.1
